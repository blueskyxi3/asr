# Generate with: openssl rand -hex 32
ASR_API_KEY=replace-with-a-random-service-token-at-least-32-characters
ASR_VERSION=0.0.2
# Optional AI Hub module pairing key, DIFFERENT from ASR_API_KEY. Generate with openssl rand -hex 32.
ASR_HOST_SECRET=
ASR_THREADS=2
ASR_WORKERS=1
ASR_MAX_QUEUE=4
ASR_QUEUE_TIMEOUT_MS=10000
ASR_INFERENCE_TIMEOUT_MS=120000
# Explicit download origin; use https://hf-mirror.com or a private compatible mirror if needed.
ASR_MODEL_ORIGIN=https://huggingface.co
# Wake weights are the pinned dsh-orb-kws package, not a Hugging Face download.
# For mainland China, optionally use https://registry.npmmirror.com.
ASR_KWS_MODEL_ORIGIN=https://registry.npmjs.org
